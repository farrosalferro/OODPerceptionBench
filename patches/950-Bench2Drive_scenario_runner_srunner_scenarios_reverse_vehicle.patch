+"""
+Reverse vehicle scenario:
+
+The scenario spawns a vehicle in front of the ego that is stopped initially.
+When the ego gets within a trigger distance, the front vehicle starts reversing
+toward the ego, forcing the ego to take evasive action (lane change or braking).
+"""
+
+import py_trees
+import carla
+
+from srunner.scenariomanager.carla_data_provider import CarlaDataProvider
+from srunner.scenariomanager.scenarioatomics.atomic_behaviors import (
+    ReverseVehicle,
+    StopVehicle,
+    Idle,
+    ScenarioTimeout,
+    SwitchWrongDirectionTest,
+)
+from srunner.scenariomanager.scenarioatomics.atomic_trigger_conditions import (
+    InTriggerDistanceToVehicle,
+    DriveDistance,
+    WaitUntilInFrontPosition,
+)
+from srunner.scenarios.basic_scenario import BasicScenario
+from srunner.tools.background_manager import (
+    RemoveRoadLane,
+    ReAddRoadLane,
+    ChangeOppositeBehavior,
+)
+from srunner.scenariomanager.scenarioatomics.atomic_behaviors import OppositeActorFlow
+from srunner.scenariomanager.scenarioatomics.atomic_criteria import (
+    TTRDARCriterion,
+)
+try:
+    from srunner.scenariomanager.scenarioatomics.atomic_criteria import ICImmediateLateral
+except ImportError:
+    ICImmediateLateral = None
+
+
+def get_value_parameter(config, name, p_type, default):
+    if name in config.other_parameters:
+        return p_type(config.other_parameters[name]["value"])
+    else:
+        return default
+
+
+class ReverseVehicleRoute(BasicScenario):
+    """
+    This class implements a scenario where a vehicle in front of the ego stops
+    initially, then reverses toward the ego when triggered, forcing an immediate
+    lane change or evasive action.
+
+    This is a single ego vehicle scenario
+    """
+
+    timeout = 120  # Timeout of scenario in seconds
+
+    def __init__(
+        self,
+        world,
+        ego_vehicles,
+        config,
+        randomize=False,
+        debug_mode=False,
+        criteria_enable=True,
+        timeout=60,
+    ):
+        """
+        Setup all relevant parameters and create scenario
+        """
+        self._world = world
+        self._map = CarlaDataProvider.get_map()
+        self.timeout = timeout
+
+        # Scenario parameters
+        self._trigger_distance = get_value_parameter(
+            config, "trigger_distance", int, 30
+        )  # Distance at which reversing is triggered (meters)
+        self._reverse_speed = get_value_parameter(
+            config, "reverse_speed", float, 2.0
+        )  # Speed at which the vehicle reverses (m/s)
+        self._front_vehicle_model = get_value_parameter(
+            config, "front_vehicle_model", str, "vehicle.tesla.model3"
+        )
+
+        self._front_vehicle_distance = (
+            60  # Distance ahead to spawn the front vehicle (meters)
+        )
+        self._scenario_timeout = 240  # Maximum scenario duration in seconds
+        self._end_distance = 70
+        self._offset = 0.6
+
+        # Get reference waypoint from trigger point
+        self._trigger_location = config.trigger_points[0].location
+        self._reference_waypoint = self._map.get_waypoint(self._trigger_location)
+
+        super().__init__(
+            "ReverseVehicle",
+            ego_vehicles,
+            config,
+            world,
+            debug_mode,
+            criteria_enable=criteria_enable,
+        )
+
+    def _initialize_actors(self, config):
+        """
+        Custom initialization - Spawn a vehicle ahead of the ego
+        """
+        # Find a position ahead of the ego on the same lane
+        front_waypoints = self._reference_waypoint.next(self._front_vehicle_distance)
+        if not front_waypoints:
+            raise ValueError(
+                "Couldn't find viable position for the vehicle in front of the ego"
+            )
+
+        front_waypoint = front_waypoints[0]
+        displacement = self._offset * front_waypoint.lane_width / 2
+        r_vec = front_waypoint.transform.get_right_vector()
+        front_transform = front_waypoint.transform
+        front_transform.location += carla.Location(
+            x=displacement * r_vec.x, y=displacement * r_vec.y, z=0.3
+        )
+        front_transform = carla.Transform(
+            front_transform.location, carla.Rotation(yaw=180.0)
+        )
+        self._front_vehicle = CarlaDataProvider.request_new_actor(
+            self._front_vehicle_model, front_transform, rolename="scenario"
+        )
+
+        if self._front_vehicle is None:
+            raise ValueError("Couldn't spawn the vehicle in front of the ego")
+
+        # Apply handbrake to keep it stationary initially
+        self._front_vehicle.apply_control(carla.VehicleControl(hand_brake=True))
+        self.other_actors.append(self._front_vehicle)
+
+        self._end_wp = front_waypoint.next(self._end_distance)[0]
+
+    def _create_behavior(self):
+        """
+        Creates the behavior tree for the scenario:
+        1. Remove ego road lane (if route mode)
+        2. Stop the front vehicle (ensure it's stationary)
+        3. Wait for ego to approach within trigger distance
+        4. Clear opposite lane completely (remove existing traffic + stop spawning)
+        5. Start reversing the front vehicle
+        6. Wait for either timeout or ego passes the front vehicle
+        7. Clean up and restore all traffic and lanes
+        """
+        root = py_trees.composites.Sequence("ReverseVehicleSequence")
+
+        # Clear adjacent lanes early if in route mode
+        if self.route_mode:
+            root.add_child(RemoveRoadLane(self._reference_waypoint))
+            # Remove all existing opposite lane traffic and stop new spawns
+            root.add_child(ChangeOppositeBehavior(active=False))
+
+        # Ensure the front vehicle is stopped initially
+        root.add_child(StopVehicle(self._front_vehicle, brake_value=1.0))
+
+        # Create end condition: Either timeout or ego passes the front vehicle
+        end_condition = py_trees.composites.Parallel(
+            policy=py_trees.common.ParallelPolicy.SUCCESS_ON_ONE
+        )
+        end_condition.add_child(
+            ScenarioTimeout(self._scenario_timeout, self.config.name)
+        )
+        end_condition.add_child(
+            WaitUntilInFrontPosition(
+                self.ego_vehicles[0], self._end_wp.transform, False  # Lenient check
+            )
+        )
+
+        behavior = py_trees.composites.Sequence()
+        behavior.add_child(
+            InTriggerDistanceToVehicle(
+                self._front_vehicle, self.ego_vehicles[0], self._trigger_distance
+            )
+        )
+        if self.route_mode:
+            behavior.add_child(SwitchWrongDirectionTest(False))
+        behavior.add_child(
+            ReverseVehicle(self._front_vehicle, reverse_speed=self._reverse_speed)
+        )  # This won't reach SUCCESS as the distance / speed is not set
+
+        end_condition.add_child(behavior)
+        root.add_child(end_condition)
+
+        # Stop the front vehicle after scenario ends
+        root.add_child(StopVehicle(self._front_vehicle, brake_value=1.0))
+
+        # Restore opposite direction traffic and lanes
+        if self.route_mode:
+            root.add_child(SwitchWrongDirectionTest(True))
+            root.add_child(ChangeOppositeBehavior(active=True))
+            root.add_child(ReAddRoadLane(0))
+            # if self._opposite_lane_wp:
+            #     root.add_child(ReAddRoadLane(self._opposite_lane_offset))
+
+        return root
+
+    def _create_test_criteria(self):
+        """
+        Empty, the route already has a collision criteria
+        """
+        criteria = []
+
+        if hasattr(self, "_front_vehicle") and self._front_vehicle:
+            criteria.append(
+                TTRDARCriterion(
+                    self.ego_vehicles[0],
+                    self._front_vehicle,
+                    d_obs=60.0,
+                    ttc_threshold=3.5,
+                    name="TTRDARReverseVehicle",
+                )
+            )
+            criteria.append(
+                ICImmediateLateral(
+                    self.ego_vehicles[0],
+                    self._front_vehicle,
+                    ttc_threshold=3.0,
+                    theta_y=0.3,
+                    d_obs=60.0,
+                    name="ICImmediateLateralReverseVehicle",
+                )
+            )
+
+        return criteria
+
+    def __del__(self):
+        """
+        Remove all actors upon deletion
+        """
+        self.remove_all_actors()
