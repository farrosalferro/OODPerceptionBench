+def _sanitize_floats(obj):
+    """Replace inf/nan floats with None so the data is always JSON-serialisable.
+
+    Also coerces numpy scalar types (np.float32/np.float64/np.int*/...) to native
+    Python scalars so json.dump never chokes on them. The TTR/DAR criterion emits
+    ttc_at_reaction = float('inf') in the no-closing case; without this the dump
+    raises mid-write and truncates the result JSON."""
+    # numpy scalar -> native Python scalar (no hard numpy dependency)
+    if hasattr(obj, 'item') and type(obj).__module__ == 'numpy':
+        try:
+            obj = obj.item()
+        except Exception:
+            return None
+    if isinstance(obj, float):
+        if math.isinf(obj) or math.isnan(obj):
+            return None
+        return obj
+    if isinstance(obj, dict):
+        return {k: _sanitize_floats(v) for k, v in obj.items()}
+    if isinstance(obj, (list, tuple)):
+        return [_sanitize_floats(v) for v in obj]
+    return obj
+
