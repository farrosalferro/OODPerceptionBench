+            if self._collision_frame is not None and reactions_invalidated > 0:
+                msg = f"No valid reaction (collision at frame {self._collision_frame}, {reactions_invalidated} reactions invalidated)"
+            else:
+                msg = "No reaction detected"
+
+        event.set_dict(event_data)
+        event.set_message(msg)
+        self.events.append(event)
+
+        super().terminate(new_status)
+
