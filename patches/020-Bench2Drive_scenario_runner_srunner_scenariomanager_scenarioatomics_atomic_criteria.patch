+                "t_react_frame": best_reaction.get("t_react_frame"),
+                "agent_type": self._agent.type_id if self._agent else "unknown",
+                "closing_velocity": best_reaction.get("closing_velocity"),
+                "ttc_at_reaction": best_reaction.get("ttc_at_reaction"),
+                "reaction_cause": best_reaction.get("reaction_cause"),
+                "reaction_value": best_reaction.get("reaction_value"),
+                "reaction_threshold": best_reaction.get("reaction_threshold"),
+                "v_start": best_reaction.get("v_start"),
+                "v_end": best_reaction.get("v_end"),
+                # Store ALL reactions for post-hoc analysis
+                "all_reactions": self._all_reactions,
+                "num_reactions": len(self._all_reactions),
+                # Collision metadata
+                "collision_frame": self._collision_frame,
+                "reactions_invalidated_by_collision": reactions_invalidated,
+            }
+
+            cause = best_reaction.get("reaction_cause", "unknown")
+            ttr = best_reaction.get("ttr", 0)
+            dar = best_reaction.get("dar", 0)
+            msg = f"TTR={ttr:.3f}s, DAR={dar:.2f}m, cause={cause}, total_reactions={len(self._all_reactions)}"
+            if reactions_invalidated > 0:
