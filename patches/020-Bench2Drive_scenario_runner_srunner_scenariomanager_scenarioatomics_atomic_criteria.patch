+class TTRDARAnalytic(Criterion):
+    """
+    Analytic version of TTRDARCriterion for parameter calibration.
+
+    This criterion logs raw frame-by-frame data WITHOUT applying reaction
+    detection thresholds. The data can be used for post-hoc analysis to
+    determine appropriate threshold values (rho, theta_a, theta_y, ttc_threshold).
+
+    Logs per frame:
+    - distance: Distance to agent
+    - ego_velocity: Ego vehicle speed
+    - ego_acceleration: Ego vehicle acceleration
+    - lateral_offset: Ego lateral offset from lane center
+    - lateral_velocity: Lateral velocity (m/s), derivative of lateral_offset
+    - lane_id: Current lane ID
+    - closing_velocity: Rate of approach to agent (smoothed over CV_SMOOTH_WINDOW)
+    - ttc: Time-to-collision (if approaching)
+    - agent_observed: Whether agent is within d_obs
+    """
+
+    FRAME_RATE = 20.0
+    CV_SMOOTH_WINDOW = 5
+
+    def __init__(
+        self,
+        actor,
+        agent_of_interest,
+        d_obs=50.0,
+        name="TTRDARAnalytic",
+        optional=True,
+    ):
+        super().__init__(name, actor, optional, terminate_on_failure=False)
+
+        self._agent = agent_of_interest
+        self._d_obs = d_obs
+
+        # Raw data storage for post-hoc analysis
+        self._frame_data = []  # List of dicts with per-frame measurements
+        self._distance_history = []  # For TTC computation
+
+        self._map = CarlaDataProvider.get_map()
+        self._t_obs = None  # Frame when agent first observed
+
+    def _get_ego_state(self):
+        """Get current ego vehicle state."""
+        location = CarlaDataProvider.get_location(self.actor)
+        velocity = CarlaDataProvider.get_velocity(self.actor)
+        transform = CarlaDataProvider.get_transform(self.actor)
+
+        acceleration = 0.0
+        if len(self._frame_data) > 0:
+            prev_velocity = self._frame_data[-1].get("ego_velocity", 0)
+            dt = 1.0 / self.FRAME_RATE
+            acceleration = (velocity - prev_velocity) / dt
+
+        waypoint = self._map.get_waypoint(location)
+        lane_id = waypoint.lane_id if waypoint else None
+
+        if waypoint:
+            lane_center = waypoint.transform.location
+            lateral_offset = location.distance(lane_center)
+        else:
+            lateral_offset = 0.0
+
+        return location, velocity, acceleration, lane_id, lateral_offset, transform
+
+    def _get_agent_location(self):
+        if self._agent is None or not self._agent.is_alive:
+            return None
+        return CarlaDataProvider.get_location(self._agent)
+
+    def _compute_distance(self, ego_loc, agent_loc):
+        if not ego_loc or not agent_loc:
+            return float("inf")
+        return ego_loc.distance(agent_loc)
+
+    def _compute_closing_velocity(self, current_distance, current_frame):
+        """Compute closing velocity from distance history using a sliding window."""
+        if len(self._distance_history) >= self.CV_SMOOTH_WINDOW:
+            old_dist, old_frame = self._distance_history[-self.CV_SMOOTH_WINDOW]
+            dt = (current_frame - old_frame) / self.FRAME_RATE
+            if dt > 0:
+                return (old_dist - current_distance) / dt
+        elif len(self._distance_history) >= 2:
+            old_dist, old_frame = self._distance_history[-1]
+            dt = (current_frame - old_frame) / self.FRAME_RATE
+            if dt > 0:
+                return (old_dist - current_distance) / dt
+        return None
+
+    def _compute_ttc(self, distance, closing_velocity):
+        """Compute time-to-collision."""
+        if closing_velocity is not None and closing_velocity > 0.5:
+            return distance / closing_velocity
+        return None
+
+    def update(self):
+        new_status = py_trees.common.Status.RUNNING
+        frame = GameTime.get_frame()
+
+        ego_state = self._get_ego_state()
+        agent_loc = self._get_agent_location()
+
+        if ego_state[0] is None:
+            return new_status
+
+        ego_loc, ego_velocity, ego_acceleration, lane_id, lateral_offset, transform = ego_state
+        distance = self._compute_distance(ego_loc, agent_loc)
+
+        # Check observability
+        agent_observed = distance <= self._d_obs
+        if self._t_obs is None and agent_observed:
+            self._t_obs = frame
+
+        # Compute closing velocity and TTC
+        closing_velocity = self._compute_closing_velocity(distance, frame)
+        ttc = self._compute_ttc(distance, closing_velocity)
+
+        # Compute lateral velocity from consecutive frames
+        lateral_velocity = None
+        if len(self._frame_data) > 0:
+            prev_offset = self._frame_data[-1].get("lateral_offset", 0)
+            dt = 1.0 / self.FRAME_RATE
+            lateral_velocity = abs(lateral_offset - prev_offset) / dt
+
+        # Store frame data
+        frame_record = {
+            "frame": frame,
+            "distance": distance if distance != float("inf") else None,
+            "ego_velocity": ego_velocity,
+            "ego_acceleration": ego_acceleration,
+            "lateral_offset": lateral_offset,
+            "lateral_velocity": lateral_velocity,
+            "lane_id": lane_id,
+            "closing_velocity": closing_velocity,
+            "ttc": ttc,
+            "agent_observed": agent_observed,
+            "ego_x": ego_loc.x if ego_loc else None,
+            "ego_y": ego_loc.y if ego_loc else None,
+            "agent_x": agent_loc.x if agent_loc else None,
+            "agent_y": agent_loc.y if agent_loc else None,
+        }
+        self._frame_data.append(frame_record)
+
+        # Store distance history for TTC computation
+        if agent_loc and distance != float("inf"):
+            self._distance_history.append((distance, frame))
+
+        return new_status
+
+    def terminate(self, new_status):
+        """Record analytic TTR/DAR data."""
+        event = TrafficEvent(
+            event_type=TrafficEventType.TTR_DAR_ANALYTIC,
+            frame=GameTime.get_frame(),
+        )
+
+        # Compute summary statistics
+        distances = [f["distance"] for f in self._frame_data if f["distance"] is not None]
+        velocities = [f["ego_velocity"] for f in self._frame_data]
+        accelerations = [f["ego_acceleration"] for f in self._frame_data]
+        ttcs = [f["ttc"] for f in self._frame_data if f["ttc"] is not None]
+
+        event_data = {
+            "criterion_type": "TTRDARAnalytic",
+            "agent_type": self._agent.type_id if self._agent else "unknown",
+            # Time-series data for post-hoc analysis
+            "frame_data": self._frame_data,
+            # Key frame info
+            "t_obs_frame": self._t_obs,
+            "num_frames_logged": len(self._frame_data),
+            # Summary statistics
+            "min_distance": min(distances) if distances else None,
+            "max_velocity": max(velocities) if velocities else None,
+            "min_velocity": min(velocities) if velocities else None,
+            "min_acceleration": min(accelerations) if accelerations else None,
+            "max_deceleration": -min(accelerations) if accelerations else None,
+            "min_ttc": min(ttcs) if ttcs else None,
+            "frames_observed": sum(1 for f in self._frame_data if f["agent_observed"]),
+        }
+
+        event.set_dict(event_data)
+        event.set_message(f"TTRDARAnalytic: {len(self._frame_data)} frames logged")
+        self.events.append(event)
+
+        super().terminate(new_status)
+
+
