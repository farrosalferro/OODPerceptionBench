+class TTRDARCriterion(Criterion):
+    """
+    TTR, DAR, and TTC-at-Reaction measurement criterion.
+
+    Monitors the ego vehicle's reaction to an agent-of-interest and computes:
+    - TTR: Time from agent observability (t_obs) to first sustained reaction (t_react)
+    - DAR: Distance to agent at t_react
+    - TTC_react: Time-to-collision at t_react (stored as 'ttc_at_reaction')
+
+    Reaction is detected via physics-based primitives:
+    - P1 (optional): Relative speed change > rho over tau window
+    - P2: Sustained deceleration < -theta_a over tau window
+    - P3: Lateral velocity > theta_y (m/s) over tau window, or lane change
+
+    Parameters:
+    - actor: The ego vehicle
+    - agent_of_interest: The agent to track (vehicle, pedestrian, or obstacle)
+    - d_obs: Observation radius in meters (default 50.0)
+    - ttc_threshold: TTC relevance gate for data collection (default 10.0s)
+    - min_distance: Minimum distance fallback for relevance (default 15.0m)
+    - rho: Relative speed change threshold for P1 (default 0.20 = 20%)
+    - theta_a: Deceleration magnitude threshold for P2 in m/s² (default 1.0, gentle brake)
+    - theta_y: Lateral velocity threshold for P3 in m/s (default 0.5)
+    - tau: Persistence window in seconds (default 0.5)
+    - use_p1: Enable P1 speed-modulation primitive (default False)
+
+    Note: ttc_threshold is set high by default to capture all potential reactions.
+    Use post-hoc filtering with scenario-specific thresholds in analysis.
+    """
+
+    FRAME_RATE = 20.0
+    CV_SMOOTH_WINDOW = 5
+
+    def __init__(
+        self,
+        actor,
+        agent_of_interest,
+        d_obs=50.0,
+        ttc_threshold=10.0,
+        min_distance=15.0,
+        rho=0.20,
+        theta_a=1.0,
+        theta_y=0.5,
+        tau=0.5,
+        use_p1=False,
+        name="TTRDARCriterion",
+        optional=True,
+    ):
+        super().__init__(name, actor, optional, terminate_on_failure=False)
+
+        self._agent = agent_of_interest
+        self._d_obs = d_obs
+        self._ttc_threshold = ttc_threshold
+        self._min_distance = min_distance
+        self._rho = rho
+        self._theta_a = theta_a
+        self._theta_y = theta_y
+        self._tau = tau
+        self._tau_frames = int(tau * self.FRAME_RATE)
+        self._use_p1 = use_p1
+
+        # State tracking
+        self._t_obs = None
+        self._ego_history = []
+        self._agent_history = []
+        self._distance_history = []  # Track (distance, frame) for TTC computation
+
+        self._map = CarlaDataProvider.get_map()
+
+        # Track ALL reactions for post-hoc analysis
+        self._all_reactions = []
+        self._last_reaction_frame = None  # To avoid duplicate detections
+
+        # Collision invalidation: frame when ego collided with agent-of-interest
+        self._collision_frame = None
+
+    def _get_ego_state(self):
+        """Get current ego vehicle state."""
+        location = CarlaDataProvider.get_location(self.actor)
+        velocity = CarlaDataProvider.get_velocity(self.actor)
+        transform = CarlaDataProvider.get_transform(self.actor)
+
+        acceleration = 0.0
+        if len(self._ego_history) > 0:
+            prev_velocity = self._ego_history[-1][2]
+            dt = 1.0 / self.FRAME_RATE
+            acceleration = (velocity - prev_velocity) / dt
+
+        waypoint = self._map.get_waypoint(location)
+        lane_id = waypoint.lane_id if waypoint else None
+
+        if waypoint:
+            lane_center = waypoint.transform.location
+            lateral_offset = location.distance(lane_center)
+        else:
+            lateral_offset = 0.0
+
+        return location, velocity, acceleration, lane_id, lateral_offset, transform
+
+    def _get_agent_location(self):
+        if self._agent is None or not self._agent.is_alive:
+            return None
+        return CarlaDataProvider.get_location(self._agent)
+
+    def _compute_distance(self, ego_loc, agent_loc):
+        if not ego_loc or not agent_loc:
+            return float("inf")
+        return ego_loc.distance(agent_loc)
+
+    def _compute_closing_velocity(self, current_distance, current_frame, ego_velocity):
+        """Compute closing velocity from distance history using a sliding window."""
+        if len(self._distance_history) >= self.CV_SMOOTH_WINDOW:
+            old_dist, old_frame = self._distance_history[-self.CV_SMOOTH_WINDOW]
+            dt = (current_frame - old_frame) / self.FRAME_RATE
+            if dt > 0:
+                return (old_dist - current_distance) / dt
+        elif len(self._distance_history) >= 2:
+            old_dist, old_frame = self._distance_history[-1]
+            dt = (current_frame - old_frame) / self.FRAME_RATE
+            if dt > 0:
+                return (old_dist - current_distance) / dt
+        return ego_velocity
+
+    def _check_relevance(self, distance, current_frame, ego_velocity):
+        """
+        Check if agent is relevant based on TTC or minimum distance.
+
+        Returns:
+            tuple: (is_relevant: bool, closing_velocity: float, ttc: float)
+        """
+        closing_velocity = self._compute_closing_velocity(distance, current_frame, ego_velocity)
+
+        # Compute TTC
+        if closing_velocity > 0.5:  # Only if actually approaching (> 0.5 m/s)
+            ttc = distance / closing_velocity
+        else:
+            ttc = float("inf")  # Not approaching or moving apart
+
+        # Relevance: TTC below threshold OR distance below minimum
+        is_relevant = (ttc <= self._ttc_threshold) or (distance < self._min_distance)
+        return is_relevant, closing_velocity, ttc
+
+    def _check_reaction_primitives(self, current_idx):
+        """
+        Check for reaction primitives and return detailed info.
+
+        Returns:
+            dict or None: If reaction detected, returns dict with:
+                - detected: True
+                - primitive: str (P1_speed_change, P2_deceleration, P3_lateral, P3_lane_change)
+                - value: float (measured value)
+                - threshold: float (threshold used)
+            If no reaction, returns None.
+        """
+        if current_idx < self._tau_frames:
+            return None
+
+        start_idx = current_idx - self._tau_frames
+        _, _, v_start, a_start, lane_start, y_start, _ = self._ego_history[start_idx]
+        _, _, v_end, a_end, lane_end, y_end, _ = self._ego_history[current_idx]
+
+        # P1: Longitudinal Speed Modulation (optional, disabled by default)
+        if self._use_p1 and v_start > 0.1:
+            speed_change = abs(v_end - v_start) / v_start
+            if speed_change >= self._rho:
+                return {
+                    "detected": True,
+                    "primitive": "P1_speed_change",
+                    "value": speed_change,
+                    "threshold": self._rho,
+                    "v_start": v_start,
+                    "v_end": v_end,
+                }
+
+        # P2: Sustained Deceleration
+        sustained_decel = True
+        min_accel = float("inf")
+        for i in range(start_idx, current_idx + 1):
+            accel = self._ego_history[i][3]
+            min_accel = min(min_accel, accel)
+            if accel > -self._theta_a:
+                sustained_decel = False
+                break
+        if sustained_decel:
+            return {
+                "detected": True,
+                "primitive": "P2_deceleration",
+                "value": min_accel,
+                "threshold": -self._theta_a,
+            }
+
+        # P3: Lateral Commitment (velocity-based)
+        lateral_change = abs(y_end - y_start)
+        lateral_velocity = lateral_change / self._tau
+        if lateral_velocity >= self._theta_y:
+            return {
+                "detected": True,
+                "primitive": "P3_lateral",
+                "value": lateral_velocity,
+                "threshold": self._theta_y,
+            }
+        if lane_start is not None and lane_end is not None and lane_start != lane_end:
+            return {
+                "detected": True,
+                "primitive": "P3_lane_change",
+                "value": f"{lane_start} -> {lane_end}",
+                "threshold": "lane_change",
+            }
+
+        return None
+
+    def update(self):
+        new_status = py_trees.common.Status.RUNNING
+        frame = GameTime.get_frame()
+
+        ego_state = self._get_ego_state()
+        agent_loc = self._get_agent_location()
+
+        if ego_state[0] is None:
+            return new_status
+
+        ego_loc = ego_state[0]
+        ego_velocity = ego_state[1]  # velocity is the second element
+        distance = self._compute_distance(ego_loc, agent_loc)
+
+        # store history
+        self._ego_history.append((frame, *ego_state))
+        if agent_loc:
+            self._agent_history.append((frame, agent_loc))
+
+        # ------------------------------------------------------------------
+        # Collision invalidation: check Blackboard for collision with agent
+        # ------------------------------------------------------------------
+        if self._collision_frame is None and self._agent is not None:
+            try:
+                collision_info = py_trees.blackboard.Blackboard().get(
+                    f"collision_with_{self._agent.id}"
+                )
+                if collision_info is not None:
+                    self._collision_frame = collision_info.get("frame")
+            except Exception:
+                pass  # Blackboard key not yet set
+
+        # If collision occurred, still track distance history but skip reactions
+        if self._collision_frame is not None:
+            if agent_loc:
+                self._distance_history.append((distance, frame))
+            return new_status
+
+        # Check observability
+        if self._t_obs is None and distance <= self._d_obs:
+            self._t_obs = frame
+
+        # Check for ALL reactions when agent is observed and relevant
+        # Don't stop at first reaction - record all of them
+        if self._t_obs is not None:
+            is_relevant, closing_velocity, ttc = self._check_relevance(distance, frame, ego_velocity)
+            if is_relevant:
+                # Avoid duplicate detections: require at least tau_frames since last reaction
+                frames_since_last = (
+                    frame - self._last_reaction_frame
+                    if self._last_reaction_frame is not None
+                    else float("inf")
+                )
+                
+                if frames_since_last >= self._tau_frames:
+                    current_idx = len(self._ego_history) - 1
+                    reaction_info = self._check_reaction_primitives(current_idx)
+                    if reaction_info is not None:
+                        # Compute TTR for this reaction
+                        ttr = (frame - self._t_obs) / self.FRAME_RATE
+                        
+                        # Store this reaction
+                        reaction_record = {
+                            "ttr": ttr,
+                            "dar": distance,
+                            "t_obs_frame": self._t_obs,
+                            "t_react_frame": frame,
+                            "closing_velocity": closing_velocity,
+                            "ttc_at_reaction": ttc,
+                            "reaction_cause": reaction_info.get("primitive"),
+                            "reaction_value": reaction_info.get("value"),
+                            "reaction_threshold": reaction_info.get("threshold"),
+                        }
+                        
+                        # Add P1-specific fields
+                        if reaction_info.get("primitive") == "P1_speed_change":
+                            reaction_record["v_start"] = reaction_info.get("v_start")
+                            reaction_record["v_end"] = reaction_info.get("v_end")
+                        
+                        self._all_reactions.append(reaction_record)
+                        self._last_reaction_frame = frame
+
+        # Store distance history for TTC computation (after relevance check)
+        if agent_loc:
+            self._distance_history.append((distance, frame))
+
+        return new_status
+
+    def _get_first_reaction(self):
+        """Get the first chronological reaction."""
+        if not self._all_reactions:
+            return None
+        
+        # Return the first reaction (chronologically earliest)
+        return self._all_reactions[0]
+
+    def terminate(self, new_status):
+        """Record TTR/DAR event at end of scenario."""
+        event = TrafficEvent(
+            event_type=TrafficEventType.TTR_DAR_MEASUREMENT,
+            frame=GameTime.get_frame(),
+        )
+
+        # ------------------------------------------------------------------
+        # Collision invalidation: remove reactions detected at or after
+        # the collision frame (post-collision deceleration artefacts).
+        # ------------------------------------------------------------------
