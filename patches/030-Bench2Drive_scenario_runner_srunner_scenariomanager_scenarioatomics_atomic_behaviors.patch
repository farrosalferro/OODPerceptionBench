+class InvadingActorFlowModified(AtomicBehavior):
+    """
+    Similar to ActorFlow, but this is meant as an actor flow in the opposite direction that invades the lane.
+    As such, some configurations are different and for clarity, another behavior has been created
+
+    Important parameters:
+    - source_wp (carla.Waypoint): Waypoint at which actors will be spawned
+    - sink_wp (carla.Waypoint): Waypoint at which actors will be deleted
+    - spawn_dist_interval: Distance interval between spawned actors
+    - sink_dist: Actors closer to the sink than this distance will be deleted
+    - actors_speed: Speed of the actors part of the flow [m/s]
+    - offset: offset from the center lane of the actors
+    """
+
+    def __init__(
+        self,
+        source_wp,
+        sink_wp,
+        reference_actor,
+        spawn_dist,
+        sink_dist=2,
+        offset=0,
+        z_offset=0.0,
+        blueprint_name="vehicle.*",
+        name="OppositeActorFlow",
+    ):
+        """
+        Setup class members
+        """
+        super().__init__(name)
+        self._world = CarlaDataProvider.get_world()
+        self._tm = CarlaDataProvider.get_client().get_trafficmanager(
+            CarlaDataProvider.get_traffic_manager_port()
+        )
+
+        self._reference_actor = reference_actor
+
+        self._source_wp = source_wp
+        self._source_transform = self._source_wp.transform
+        # Apply z offset to prevent spawning issues with z=0.0
+        self._source_transform.location.z += z_offset
+        self._source_location = self._source_transform.location
+
+        self._sink_wp = sink_wp
+        self._sink_location = self._sink_wp.transform.location
+
+        self._spawn_dist = spawn_dist
+
+        self._sink_dist = sink_dist
+
+        self._blueprint_name = blueprint_name
+        self._attribute_filter = {}
+
+        self._actor_list = []
+
+        # Opposite direction needs earlier vehicle detection
+        self._opt_dict = {
+            "base_vehicle_threshold": 10,
+            "detection_speed_ratio": 2,
+            "distance_ratio": 0.2,
+        }
+        self._opt_dict["offset"] = offset
+
+        self._grp = CarlaDataProvider.get_global_route_planner()
+        self._map = CarlaDataProvider.get_map()
+
+        self._terminated = False
+
+    def initialise(self):
+        """Get the actor flow source and sink, depending on the reference actor speed"""
+        self._speed = self._reference_actor.get_speed_limit()  # Km / h
+        self._route = self._grp.trace_route(self._source_location, self._sink_location)
+        return super().initialise()
+
+    def _spawn_actor(self):
+        actor = CarlaDataProvider.request_new_actor(
+            self._blueprint_name,
+            self._source_transform,
+            rolename="scenario",
+            attribute_filter=self._attribute_filter,
+            tick=False,
+        )
+        if actor is None:
+            return py_trees.common.Status.RUNNING
+
+        py_trees.blackboard.Blackboard().set(
+            f"TTR_DAR_agent_{self.name}", actor, overwrite=True
+        )
+
+        controller = BasicAgent(
+            actor, self._speed, self._opt_dict, self._map, self._grp
+        )
+        controller.set_global_plan(self._route)
+        self._actor_list.append([actor, controller])
+
+    def update(self):
+        """Controls the created actors and creates / removes other when needed"""
+        # Control the vehicles, removing them when needed
+        for actor_data in list(self._actor_list):
+            actor, controller = actor_data
+            location = CarlaDataProvider.get_location(actor)
+            if not location:
+                continue
+            sink_distance = self._sink_location.distance(location)
+            if sink_distance < self._sink_dist:
+                actor.destroy()
+                self._actor_list.remove(actor_data)
+            else:
+                actor.apply_control(controller.run_step())
+
+        # Spawn new actors if needed
+        if len(self._actor_list) == 0:
+            distance = self._spawn_dist + 1
+        else:
+            actor_location = CarlaDataProvider.get_location(self._actor_list[-1][0])
+            distance = (
+                self._source_location.distance(actor_location) if actor_location else 0
+            )
+        if distance > self._spawn_dist:
+            self._spawn_actor()
+
+        return py_trees.common.Status.RUNNING
+
+    def terminate(self, new_status):
+        """
+        Default terminate. Can be extended in derived class
+        """
+        if self._terminated:
+            return
+
+        self._terminated = True
+
+        for actor, _ in self._actor_list:
+            # TODO: Actors spawned in the same frame as the behavior termination won't be removed.
+            # Patched by removing its movement
+            try:
+                actor.disable_constant_velocity()
+                actor.set_autopilot(False, CarlaDataProvider.get_traffic_manager_port())
+                actor.set_target_velocity(carla.Vector3D(0, 0, 0))
+                actor.set_target_angular_velocity(carla.Vector3D(0, 0, 0))
+                actor.destroy()
+            except RuntimeError:
+                pass  # Actor was already destroyed
+
+
+class SingleInvadingActor(AtomicBehavior):
+    def __init__(
+        self,
+        source_wp,
+        merge_start_wp,
+        merge_end_wp,
+        sink_wp,
+        speed,
+        offset,
+        blueprint_name="vehicle.*",
+        attribute_filter={"base_type": "car"},
+        z_offset=0.0,
+        sink_dist=2,
+        name="SingleInvadingActor",
+    ):
+
+        super().__init__(name)
+        self._world = CarlaDataProvider.get_world()
+        self._tm = CarlaDataProvider.get_client().get_trafficmanager(
+            CarlaDataProvider.get_traffic_manager_port()
+        )
+
+        self._source_wp = source_wp
+        self._source_transform = self._source_wp.transform
+        self._source_transform.location.z += z_offset
+        self._source_location = self._source_transform.location
+
+        self._merge_start_wp = merge_start_wp
+        self._merge_start_transform = self._merge_start_wp.transform
+        self._merge_start_location = self._merge_start_transform.location
+
+        self._merge_end_wp = merge_end_wp
+        self._merge_end_transform = self._merge_end_wp.transform
+        self._merge_end_location = self._merge_end_transform.location
+
+        self._sink_wp = sink_wp
+        self._sink_location = self._sink_wp.transform.location
+        self._sink_dist = sink_dist
+
+        self._speed = speed
+        self._offset = offset
+        self._blueprint_name = blueprint_name
+        self._attribute_filter = attribute_filter
+        self._opt_dict = {
+            "base_vehicle_threshold": 10,
+            "detection_speed_ratio": 2,
+            "distance_ratio": 0.2,
+        }
+
+        self._grp = CarlaDataProvider.get_global_route_planner()
+        self._map = CarlaDataProvider.get_map()
+
+        self._terminated = False
+
+    def initialise(self):
+        self._route = self._grp.trace_route(self._source_location, self._sink_location)
+        self._build_route_with_merge()
+
+        plan = []
+        for i, location in enumerate(self._target_locations):
+            _, road_option = self._route[i]
+            wp = self._map.get_waypoint(
+                location, project_to_road=False, lane_type=carla.LaneType.Any
+            )
+            if wp:
+                plan.append((wp, road_option))
+
+        actor = CarlaDataProvider.request_new_actor(
+            self._blueprint_name,
+            self._source_transform,
+            rolename="scenario",
+            attribute_filter=self._attribute_filter,
+            tick=False,
+        )
+        if actor is None:
+            return py_trees.common.Status.FAILURE
+
+        self._actor = actor
+
+        py_trees.blackboard.Blackboard().set(
+            f"TTR_DAR_agent_{self.name}", self._actor, overwrite=True
+        )
+
+        initial_vec = self._source_wp.transform.get_forward_vector()
+        speed_ms = self._speed / 3.6
+        self._actor.set_target_velocity(
+            carla.Vector3D(speed_ms * initial_vec.x, speed_ms * initial_vec.y, 0)
+        )
+
+        self._controller = BasicAgent(
+            actor, self._speed, self._opt_dict, self._map, self._grp
+        )
+        self._controller.set_global_plan(plan)
+
+        return super().initialise()
+
+    def _build_route_with_merge(self):
+        dist_source_to_merge_start = self._source_location.distance(
+            self._merge_start_location
+        )
+        dist_source_to_merge_end = self._source_location.distance(
+            self._merge_end_location
+        )
+
+        self._target_locations = []
+
+        for waypoint, road_option in self._route:
+            wp_location = waypoint.transform.location
+
+            dist_from_source = self._source_location.distance(wp_location)
+
+            in_merge_zone = (dist_from_source >= dist_source_to_merge_start) and (
+                dist_from_source <= dist_source_to_merge_end
+            )
+
+            if in_merge_zone:
+                target_loc = self._apply_offset_to_waypoint(waypoint)
+            else:
+                target_loc = wp_location
+
+            self._target_locations.append(target_loc)
+
+    def _apply_offset_to_waypoint(self, waypoint):
+        right_vector = (
+            waypoint.transform.get_right_vector() * -1
+        )  # -1 because we want to move to the left
+        offset_location = carla.Location(
+            x=waypoint.transform.location.x + self._offset * right_vector.x,
+            y=waypoint.transform.location.y + self._offset * right_vector.y,
+            z=waypoint.transform.location.z,
+        )
+
+        return offset_location
+
+    def update(self):
+        location = CarlaDataProvider.get_location(self._actor)
+        sink_distance = self._sink_location.distance(location)
+        if sink_distance < self._sink_dist:
+            self._actor.destroy()
+            return py_trees.common.Status.SUCCESS
+        else:
+            self._actor.apply_control(self._controller.run_step())
+
+        return py_trees.common.Status.RUNNING
+
+    def terminate(self, new_status):
+        if self._terminated:
+            return
+
+        try:
+            self._terminated = True
+            self._actor.disable_constant_velocity()
+            self._actor.set_autopilot(
+                False, CarlaDataProvider.get_traffic_manager_port()
+            )
+            self._actor.set_target_velocity(carla.Vector3D(0, 0, 0))
+            self._actor.set_target_angular_velocity(carla.Vector3D(0, 0, 0))
+            self._actor.destroy()
+        except RuntimeError:
+            pass
+
 
